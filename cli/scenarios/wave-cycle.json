{
  "name": "wave-cycle",
  "description": "单怪：开局 → 选波 → 等待出怪 → 击杀 → 原生清波 → 集结 → 下一层可选。每步都以状态后置条件为准，不用固定 sleep。",
  "timeoutSeconds": 240,
  "steps": [
    { "name": "村庄且可开局", "kind": "wait", "expect": "capabilities.start=true", "timeoutSeconds": 20 },
    { "name": "开局", "kind": "action", "cmd": "startRun",
      "expect": "sessionStage=Selecting", "timeoutSeconds": 20 },
    { "name": "选择波次 0", "kind": "action", "cmd": "choose", "index": 0,
      "expect": "sessionStage=Combat", "timeoutSeconds": 60 },
    { "name": "原生出怪（至少一只未死）", "kind": "wait", "expect": "enemies.0.dead=false", "timeoutSeconds": 90 },
    { "name": "请求击杀", "kind": "action", "cmd": "killAll", "settleQueued": true,
      "expect": "sessionStage=Carve", "timeoutSeconds": 60 },
    { "name": "清波奖励只结算一次（PT 增加）", "kind": "assert", "expect": "pt>=0" },
    { "name": "回到集结点可购买", "kind": "wait", "expect": "shopAvailable=true", "timeoutSeconds": 180 },
    { "name": "进入下一层选择", "kind": "assert", "expect": "sessionStage=Selecting" }
  ]
}