{
  "name": "mhr-roguelike-research",
  "private": true,
  "version": "0.2.0",
  "description": "MHRise arena roguelike mod — TypeScript core compiled to REFramework Lua via TypeScriptToLua; npm run build builds AND deploys to the game",
  "scripts": {
    "build": "npm run build:nocopy && node scripts/deploy.js",
    "build:nocopy": "npm run gen && node scripts/build-config.js && tstl && node scripts/finalize-bundle.js",
    "dev": "node scripts/build-config.js && tstl --watch",
    "deploy": "node scripts/deploy.js",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "npm run gen && node scripts/build-config.js",
    "pretest": "npm run gen && node scripts/build-config.js",
    "test": "vitest run",
    "check": "node scripts/check-lua.js",
    "check:runtime": "python scripts/check-lua-runtime.py",
    "gen": "node scripts/gen-enums.js && node scripts/gen-types.js",
    "test:cli": "node cli/tests/contract.mjs",
    "cli": "node cli/mhr.mjs"
  },
  "devDependencies": {
    "@typescript-to-lua/language-extensions": "^1.19.0",
    "lua-types": "^2.13.1",
    "typescript": "6.0.2",
    "typescript-to-lua": "^1.37.1",
    "luaparse": "^0.3.1",
    "vitest": "^2.1.0"
  }
}
